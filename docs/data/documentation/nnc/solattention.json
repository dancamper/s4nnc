{"variants":[{"paths":["\/documentation\/nnc\/solattention"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/SolAttention","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Forward-only, parameter-free Sol approximate attention with exactly three inputs: Q, K, V."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SolAttention"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inputs must have the same contiguous rank-4 NHWC "},{"type":"codeVoice","code":"[N, T, H, D]"},{"type":"text","text":" shape. Output"},{"type":"text","text":" "},{"type":"text","text":"retains that shape and separate heads; no layout conversion is implicit."},{"type":"text","text":" "},{"type":"codeVoice","code":"approximationRange"},{"type":"text","text":" is half-open and applies to both Q and KV. Only query"},{"type":"text","text":" "},{"type":"text","text":"groups and KV blocks wholly within the range may use summaries; protected"},{"type":"text","text":" "},{"type":"text","text":"and boundary-crossing interactions remain token-level. "},{"type":"codeVoice","code":"localBlockRadius"},{"type":"text","text":" "},{"type":"text","text":"must be at least one and keeps neighboring KV blocks exact."}]},{"type":"paragraph","inlineContent":[{"code":"scale","type":"codeVoice"},{"type":"text","text":" and "},{"code":"tau","type":"codeVoice"},{"type":"text","text":" must be finite. Zero and negative scales are supported;"},{"type":"text","text":" "},{"code":"tau = 0","type":"codeVoice"},{"type":"text","text":" does not request dense attention. Use "},{"code":"ScaledDotProductAttention","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"for dense attention."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"CPU supports FP32 and general positive head, block, and query dimensions."},{"type":"text","text":" "},{"type":"text","text":"MPS requires FP16, D=128, block\/query sizes in {16, 32, 64}, and query size"},{"type":"text","text":" "},{"type":"text","text":"no larger than KV block size. MPS selects INT8 on neural-accelerator hardware"},{"type":"text","text":" "},{"type":"text","text":"and floating-point SIMD otherwise. "},{"type":"codeVoice","code":".disableMFANeuralAccelerators"},{"type":"text","text":" selects"},{"type":"text","text":" "},{"type":"text","text":"the latter; it is distinct from "},{"type":"codeVoice","code":".disableMFAAppleNeuralEngine"},{"type":"text","text":" (ANE)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"CUDA, backward, causal\/masked attention, GQA, unequal-length cross-attention,"},{"type":"text","text":" "},{"type":"text","text":"and noncontiguous inputs are unsupported. There is no fallback to another op."}]}],"kind":"content"}],"kind":"symbol","relationshipsSections":[{"type":"inheritsFrom","title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/Model"]},{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/AnyModel"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC"]]},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/SolAttention\/init(scale:tau:approximationRange:blockSize:queryBlockSize:localBlockRadius:name:)"]}],"metadata":{"role":"symbol","modules":[{"name":"NNC"}],"externalID":"s:3NNC12SolAttentionC","navigatorTitle":[{"kind":"identifier","text":"SolAttention"}],"roleHeading":"Class","symbolKind":"class","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SolAttention"}],"title":"SolAttention"},"references":{"doc://org.liuliu.s4nnc/documentation/NNC/SolAttention/init(scale:tau:approximationRange:blockSize:queryBlockSize:localBlockRadius:name:)":{"title":"init(scale:tau:approximationRange:blockSize:queryBlockSize:localBlockRadius:name:)","kind":"symbol","role":"symbol","url":"\/documentation\/nnc\/solattention\/init(scale:tau:approximationrange:blocksize:queryblocksize:localblockradius:name:)","type":"topic","identifier":"doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/SolAttention\/init(scale:tau:approximationRange:blockSize:queryBlockSize:localBlockRadius:name:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"scale","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Float","preciseIdentifier":"s:Sf","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tau","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Float","preciseIdentifier":"s:Sf","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"approximationRange","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Range","preciseIdentifier":"s:Sn","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"blockSize"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"queryBlockSize"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"localBlockRadius"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":")"}],"abstract":[]},"doc://org.liuliu.s4nnc/documentation/NNC/Model":{"role":"symbol","abstract":[{"text":"A model is a base class for stateful operations on a dynamic graph. It can be","type":"text"},{"text":" ","type":"text"},{"text":"use to construct computations statically, thus, more efficient.","type":"text"}],"kind":"symbol","title":"Model","type":"topic","url":"\/documentation\/nnc\/model","identifier":"doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/Model","navigatorTitle":[{"kind":"identifier","text":"Model"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Model"}]},"doc://org.liuliu.s4nnc/documentation/NNC/AnyModel":{"role":"symbol","abstract":[],"kind":"symbol","title":"AnyModel","type":"topic","url":"\/documentation\/nnc\/anymodel","identifier":"doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/AnyModel","navigatorTitle":[{"kind":"identifier","text":"AnyModel"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyModel","kind":"identifier"}]},"doc://org.liuliu.s4nnc/documentation/NNC/SolAttention":{"title":"SolAttention","url":"\/documentation\/nnc\/solattention","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SolAttention","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/SolAttention","role":"symbol","abstract":[{"text":"Forward-only, parameter-free Sol approximate attention with exactly three inputs: Q, K, V.","type":"text"}],"navigatorTitle":[{"text":"SolAttention","kind":"identifier"}],"kind":"symbol"},"doc://org.liuliu.s4nnc/documentation/NNC":{"role":"collection","abstract":[],"kind":"symbol","title":"NNC","type":"topic","url":"\/documentation\/nnc","identifier":"doc:\/\/org.liuliu.s4nnc\/documentation\/NNC"}}}